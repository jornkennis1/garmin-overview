# Copy this file to ".env" and fill in your own values.
# .env is git-ignored and must never be committed. Do NOT put real values in this example file.

GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=change-me

# Optional: where login tokens are cached (default: ~/.garminconnect, outside the repo)
# GARMIN_TOKEN_DIR=~/.garminconnect
